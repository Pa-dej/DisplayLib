// DisplayLib - настройки плагина (конфиг Jumper, .jmc)

// Следить за папкой screens/ и перечитывать изменённые файлы экранов без /displaylib reload.
// На боевом сервере можно выключить.
boolean hotReload = true;

// Сторожевой таймер скриптов: один вызов функции скрипта (onOpen, обработчик клика,
// колбэк таймера) прерывается, если длится дольше указанного числа миллисекунд.
// 0 - без ограничения.
int scriptTimeoutMs = 1000;

// Когда закрывать приватный экран автоматически (выход с сервера - всегда):
//   death       - смерть игрока
//   worldChange - смена мира (экран остаётся в старом мире)
//   teleport    - телепорт дальше N блоков (0 - не закрывать)
//   inventory   - открытие любого инвентаря (сундук, верстак, GUI другого плагина)
dyn closeOn = { death: true, worldChange: true, teleport: 8, inventory: false };
