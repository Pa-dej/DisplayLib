// DisplayLib - настройки плагина (конфиг Jumper, .jmc)

// Следить за папкой screens/ и перечитывать изменённые файлы экранов без /displaylib reload.
// На боевом сервере можно выключить.
boolean hotReload = true;

// Сторожевой таймер скриптов: один вызов функции скрипта (onOpen, обработчик клика,
// колбэк таймера) прерывается, если длится дольше указанного числа миллисекунд.
// 0 - без ограничения.
int scriptTimeoutMs = 1000;

// Когда закрывать приватный экран автоматически (выход с сервера - всегда):
//   death       - смерть игрока
//   worldChange - смена мира (экран остаётся в старом мире)
//   teleport    - телепорт дальше N блоков (0 - не закрывать)
//   inventory   - открытие любого инвентаря (сундук, верстак, GUI другого плагина)
dyn closeOn = { death: true, worldChange: true, teleport: 8, inventory: false };

// Глобал storage скриптов:
//   persist         - сохранять на диск (plugins/DisplayLib/data/storage/): данные игрока переживают
//                     выход и перезапуск, данные публичного экрана - перезапуск. false - только в памяти.
//   autosaveSeconds - как часто сохранять изменившиеся данные (0 - только при выходе игрока и выключении)
dyn storage = { persist: true, autosaveSeconds: 300 };

// Частицы (particles/*.jmc, /displaylib particle):
//   maxAlive     - сколько частиц может жить одновременно на всём сервере; новые сверх предела не появляются
//   packets      - показывать частицы пакетами: на сервере нет сущностей (ни в чанках, ни в трекере), нагрузка
//                  на основной поток в разы меньше. false - настоящие Display-сущности (как раньше). На другой
//                  версии сервера плагин сам вернётся к сущностям.
//   viewDistance - с какого расстояния от точки запуска эффекта игроки видят его частицы (только для пакетов)
//   async        - частицы без коллизий (motion.collide: false) считать в отдельном потоке: основной поток только
//                  создаёт их и решает, кому показывать. Только вместе с packets. С коллизиями - всегда основной поток
//                  (блоки мира читать из другого потока нельзя).
dyn particles = { maxAlive: 1500, packets: true, viewDistance: 96, async: true };

// Экраны:
//   packets      - показывать сущности экранов пакетами: в мире их нет (не сохраняются, не нагружают трекер),
//                  приватный экран видит только его владелец, а на публичном экране у каждого игрока своё
//                  наведение (hover-анимация видна только тому, кто смотрит на виджет). false - настоящие
//                  сущности, как раньше (на публичных экранах тогда только подсказки). На другой версии
//                  сервера плагин сам вернётся к сущностям.
//   viewDistance - с какого расстояния игроки видят публичные экраны (только для пакетов)
dyn screens = { packets: true, viewDistance: 64 };

// Наборы содержимого других плагинов: папки в plugins/, у каждой свои screens/, scripts/, particles/ и
// scripts.jma (политика доступа скриптов этой папки). Плагин может зарегистрировать свою папку и сам:
// ContentPacks.register(this) в onEnable - тогда здесь его писать не нужно.
// dyn packs = ["WordBomb"];
