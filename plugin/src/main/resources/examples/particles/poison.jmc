// poison: зелёные черепа медленно всплывают вокруг точки и сжимаются. Видит только игрок, для которого запущен:
// /displaylib particle poison ~ ~1 ~ <игрок>
String id = "poison";
String viewers = "owner";
int keyframeTicks = 6;

dyn render = {
    type: "TEXT",
    text: "☠",
    colors: ["#55ff55", "#2bd92b", "#9dff9d"],
    shadow: true,
};

dyn emitter = { shape: "BOX", size: [1.2, 1.2, 1.2], count: 6, duration: 40, rate: 0.5 };   // 2 секунды по частице за 2 тика

dyn motion = {
    lifetime: [50, 80],
    speed: [0.03, 0.06],
    direction: [0, 1, 0],
    spread: 10,
    drag: 0.06,
};

dyn animation = { scale: [0.6, 1.1], endScale: 0, easing: "EASE_IN_OUT", fadeIn: 8 };
