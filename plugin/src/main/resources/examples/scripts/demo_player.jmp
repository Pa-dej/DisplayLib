// demo_player.jmp: PlayerAPI. На приватном экране player - глобал, в обработчиках он же приходит аргументом.

void refresh() {
    screen.widget("info").text([
        { text: player.name(), color: "white" }, { text: player.op() ? " (op)" : "", color: "gold" },
        { text: "  HP " + player.health(), color: "red" },
        { text: "  " + player.gamemode(), color: "gray" },
    ]);
    screen.widget("gamemode").text("Режим: " + player.gamemode());
}

void onOpen() { refresh(); }

void heal(dyn widget, dyn player) {
    player.health(20);
    player.sound("entity.player.levelup", 0.6, 1.5);
    refresh();
}

void hurt(dyn widget, dyn player) {
    double hp = player.health();
    player.health(hp > 2 ? hp - 2 : 1);
    player.sound("entity.player.hurt", 0.8, 1.0);
    refresh();
}

void gamemode(dyn widget, dyn player) {
    // по кругу: survival → creative → adventure → spectator
    String gm = player.gamemode();                       // в нижнем регистре: "survival", "creative", …
    player.gamemode(gm == "survival" ? "creative" : gm == "creative" ? "adventure" : gm == "adventure" ? "spectator" : "survival");
    refresh();
}

void whisper(dyn widget, dyn player) {
    player.message("Привет, " + player.name() + "!", "#47a2b6");
    player.message([ { text: "Сообщение сегментами: ", color: "gray" }, { text: "работает", color: "green" } ]);
    player.command("me машет рукой");            // команда от имени игрока
}

// Поле ввода: следующее сообщение игрока в чат не уходит в чат, а приходит в функцию (player.input).
// Таймаут 30 с (600 тиков); ожидание снимается и при закрытии экрана. Повторный клик - отмена.
int asked = 0;

void fieldText(dyn widget, String value, String color) {
    widget.text([ { text: "Поле ввода: ", color: "gray" }, { text: value, color: color } ]);
}

void field(dyn widget, dyn player) {
    if (player.awaitingInput()) {
        player.cancelInput();
        asked++;
        fieldText(widget, "нажмите", "white");
        return;
    }
    asked++;
    int mine = asked;
    fieldText(widget, "пишите в чат…", "yellow");
    player.input([ { text: "Напишите текст в чат", color: "#47a2b6" }, { text: " (30 с, повторный клик - отмена)", color: "gray" } ], 600, text -> {
        asked++;
        fieldText(widget, text, "white");
        player.sound("ui.button.click");
    });
    // не ответил за 30 с - вернуть подпись
    timer.after(600, () -> { if (asked == mine) fieldText(widget, "нажмите", "white"); });
}
