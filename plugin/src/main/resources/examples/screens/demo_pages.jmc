// demo_pages: постраничный список, который заполняет скрипт. Кнопки ◀/▶ меняют страницу в storage и делают
// screen.switchTo(screen.id()) - тот же экран открывается заново, а morph перетекает из старых слов в новые:
// цель анимации - состояние виджетов после onOpen. Скрипт: scripts/demo_pages.jmp.

String id = "demo_pages";
String screenType = "PRIVATE";
int tickRate = 4;
String script = "demo_pages.jmp";
dyn morph = { enabled: true, duration: 10, steps: 10 };

dyn background = { color: [40, 40, 48], alpha: 200, scale: [12, 5, 1] };

dyn row = { scale: [0.35, 0.35, 0.35], tolerance: [0, 0], backgroundColor: [30, 32, 44], backgroundAlpha: 160 };

dyn widgets = [
    { id: "title", text: [ { text: "Страницы", color: "#47a2b6" } ], position: [0, 1.125, -0.01], scale: [0.5, 0.5, 0.5], tolerance: [0, 0] },

    // строки: в файле - заглушки, слова пишет onOpen
