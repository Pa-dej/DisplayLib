    { id: "row_5", text: "…", position: [0.3, 0.9, -0.01],   scale: row.scale, tolerance: row.tolerance, backgroundColor: row.backgroundColor, backgroundAlpha: row.backgroundAlpha },
    { id: "row_6", text: "…", position: [0.3, 0.76, -0.01],  scale: row.scale, tolerance: row.tolerance, backgroundColor: row.backgroundColor, backgroundAlpha: row.backgroundAlpha },
    { id: "row_7", text: "…", position: [0.3, 0.62, -0.01],  scale: row.scale, tolerance: row.tolerance, backgroundColor: row.backgroundColor, backgroundAlpha: row.backgroundAlpha },
    { id: "row_8", text: "…", position: [0.3, 0.48, -0.01],  scale: row.scale, tolerance: row.tolerance, backgroundColor: row.backgroundColor, backgroundAlpha: row.backgroundAlpha },

    { id: "prev", text: "◀", position: [-0.45, 0.29, -0.01], scale: [0.4, 0.4, 0.4], tolerance: [0.06, 0.05],
      backgroundColor: [31, 72, 81], backgroundAlpha: 200, hoveredBackgroundColor: [46, 105, 117], hoveredBackgroundAlpha: 230, onClick: true },
    { id: "page", text: "Страница ?", position: [0, 0.29, -0.01], scale: [0.35, 0.35, 0.35], tolerance: [0, 0], backgroundAlpha: 0 },
