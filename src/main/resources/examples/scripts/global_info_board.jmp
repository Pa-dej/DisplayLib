// Global Info Board: информационная доска сервера (скрипт DisplayLib на Jumper, .jmp)
// Экран публичный: глобал player равен null, кликнувший игрок приходит аргументом обработчика,
// поэтому сообщения отправляются ему напрямую.

void onOpen() {
    log.info("Global info board opened");
    // Обновляем время при открытии
    updateServerTime();
}

void onClose() {
    log.info("Global info board closed");
}

// Отправить игроку список строк (если игрок известен)
void tell(dyn player, dyn lines) {
    if (player == null) return;
    for (dyn line : lines) {
        player.message(line);
    }
}

// Показать правила сервера
void show_rules(dyn widget, dyn player) {
    log.info("Someone requested server rules");
    // Правила показываем в чат
    tell(player, [
        "§6=== Правила сервера ===",
        "§71. Не гриферить постройки других игроков",
        "§72. Не использовать читы и дюпы",
        "§73. Быть вежливым в чате",
        "§74. Не спамить и не флудить",
        "§75. Слушаться администрацию"
    ]);
}

// Показать список команд
void show_commands(dyn widget, dyn player) {
    log.info("Someone requested command list");
    // Показать доступные команды
    tell(player, [
        "§e=== Доступные команды ===",
        "§a/spawn §7- телепорт на спавн",
        "§a/home §7- телепорт домой",
        "§a/sethome §7- установить дом",
        "§a/tpa <игрок> §7- запрос телепортации",
        "§a/balance §7- проверить баланс",
        "§a/shop §7- открыть магазин"
    ]);
}

// Показать онлайн игроков
void show_online(dyn widget, dyn player) {
    log.info("Someone requested online players list");
    // Показать список онлайн игроков
    // TODO: нет в API (список игроков сервера); пример логики:
    //   dyn online = [];
    //   for (dyn p : server.getOnlinePlayers()) online.push(p.getName());
    //   player.message("§b=== Онлайн игроки (" + online.length + ") ===");
    //   for (int i = 0; i < online.length; i++) player.message("§7" + (i + 1) + ". §f" + online[i]);
    if (player != null) {
        player.message("§b=== Онлайн игроки ===");
        player.message("§7Список онлайн игроков пока недоступен из скрипта");
    }
    log.warn("show_online: список онлайн игроков недоступен из API скриптов");
}

