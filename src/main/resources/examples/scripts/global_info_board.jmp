// Показать новости
void show_news(dyn widget, dyn player) {
    log.info("Someone requested news");
    // Показать последние новости сервера
    tell(player, [
        "§c=== Последние новости ===",
        "§6[15.03.2024] §fОбновление 1.2.0",
        "§7- Добавлены новые квесты",
        "§7- Исправлены баги с экономикой",
        "§7- Улучшена производительность",
        "",
        "§6[10.03.2024] §fВесенний ивент",
        "§7- Специальные награды до 31 марта",
        "§7- Новые достижения"
    ]);
}

// Показать полезные ссылки
void show_links(dyn widget, dyn player) {
    log.info("Someone requested useful links");
    // Показать ссылки на Discord, YouTube и т.д.
    tell(player, [
        "§b=== Полезные ссылки ===",
        "§9Discord: §fhttps://discord.gg/yourserver",
        "§cYouTube: §fhttps://youtube.com/yourchannel",
        "§eФорум: §fhttps://forum.yourserver.com",
        "§aВКонтакте: §fhttps://vk.com/yourgroup",
        "",
        "§7Кликните на ссылку в чате для перехода!"
    ]);
}

// Обновить время сервера
void update_time(dyn widget, dyn player) {
    log.info("Updating server time display");
    updateServerTime();
}

// Вспомогательная функция для обновления времени
void updateServerTime() {
    // Получаем текущее время и обновляем виджет
    dyn timeWidget = screen.widget("server_time");
    if (timeWidget == null) return;

    dyn cal = java.util.Calendar.getInstance();
    String currentTime = format("%02d:%02d:%02d",
        cal.get(java.util.Calendar.HOUR_OF_DAY), cal.get(java.util.Calendar.MINUTE), cal.get(java.util.Calendar.SECOND));
    String currentDate = format("%02d.%02d.%04d",
        cal.get(java.util.Calendar.DAY_OF_MONTH), cal.get(java.util.Calendar.MONTH) + 1, cal.get(java.util.Calendar.YEAR));

    timeWidget.text("🕐 " + currentDate + " " + currentTime);
}

