    log.info("Someone requested server statistics");
    // Показать различную статистику
    // TODO: нет в API (онлайн, uptime, TPS, память); пример логики:
    //   player.message("§7Онлайн: §f" + server.getOnlinePlayers().size() + "/" + server.getMaxPlayers());
