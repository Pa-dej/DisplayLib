// demo_frames: кадровая анимация текста. frames - кадры (строки или сегменты), сменяются каждые frameInterval тиков;
// hoveredFrames - свой набор при наведении. text = первый кадр. Тикается каждый серверный тик независимо от tickRate.
// Из скрипта: widget.frames(list, ticks); widget.text(...) отменяет анимацию.

String id = "demo_frames";
String screenType = "PRIVATE";
int tickRate = 4;
String script = "demo_frames.jmp";
dyn morph = { enabled: true, duration: 6, steps: 3 };

dyn background = { color: [40, 40, 48], alpha: 200, scale: [12, 5, 1] };

dyn widgets = [
    { id: "title", text: [ { text: "Кадры", color: "#47a2b6" } ], position: [0, 1.125, -0.01], scale: [0.5, 0.5, 0.5], tolerance: [0, 0] },

    // три точки
    { id: "loading", frames: ["Загрузка", "Загрузка.", "Загрузка..", "Загрузка..."], frameInterval: 6,
      position: [-0.3, 0.9, -0.01], scale: [0.4, 0.4, 0.4], tolerance: [0, 0], backgroundAlpha: 0 },
    // спрайты частиц как кадры
    { id: "gust", frames: [ [ { atlas: "minecraft:particles", sprite: "small_gust_0" } ], [ { atlas: "minecraft:particles", sprite: "small_gust_1" } ],
                            [ { atlas: "minecraft:particles", sprite: "small_gust_2" } ], [ { atlas: "minecraft:particles", sprite: "small_gust_3" } ],
                            [ { atlas: "minecraft:particles", sprite: "small_gust_4" } ], [ { atlas: "minecraft:particles", sprite: "small_gust_5" } ],
                            [ { atlas: "minecraft:particles", sprite: "small_gust_6" } ] ], frameInterval: 3,
      position: [0.4, 0.9, -0.01], scale: [1, 1, 1], tolerance: [0, 0], backgroundAlpha: 0 },

    // мигающее сердце: сегменты с цветом + спрайт HUD
    { id: "hp", frames: [ [ { text: "HP ", color: "gray" }, { atlas: "minecraft:gui", sprite: "hud/heart/full" } ],
                          [ { text: "HP ", color: "gray" }, { atlas: "minecraft:gui", sprite: "hud/heart/half" } ],
                          [ { text: "HP ", color: "gray" }, { atlas: "minecraft:gui", sprite: "hud/heart/container" } ],
                          [ { text: "HP ", color: "gray" }, { atlas: "minecraft:gui", sprite: "hud/heart/half" } ] ], frameInterval: 4,
      position: [0, 0.7, -0.01], scale: [0.4, 0.4, 0.4], tolerance: [0, 0], backgroundAlpha: 0 },

    // в покое статичный текст, при наведении - бегущая стрелка
    { id: "play", text: "Играть", hoveredFrames: ["> Играть  ", " > Играть ", "  > Играть", "   Играть>"], hoveredFrameInterval: 3,
      position: [-0.35, 0.45, -0.01], scale: [0.4, 0.4, 0.4], tolerance: [0.2, 0.05],
      backgroundColor: [31, 72, 81], backgroundAlpha: 200, hoveredBackgroundColor: [46, 105, 117], hoveredBackgroundAlpha: 230, onClick: true },
    // анимация и в покое, и при наведении, с разными интервалами
    { id: "shimmer", frames: [ [ { text: "Магазин", color: "white" } ], [ { text: "Магазин", color: "yellow" } ], [ { text: "Магазин", color: "gold" } ], [ { text: "Магазин", color: "yellow" } ] ], frameInterval: 8,
      hoveredFrames: [ [ { text: "Магазин", color: "aqua" } ], [ { text: "Магазин", color: "white" } ] ], hoveredFrameInterval: 4,
      position: [0.35, 0.45, -0.01], scale: [0.4, 0.4, 0.4], tolerance: [0.21, 0.05],
      backgroundColor: [30, 32, 44], backgroundAlpha: 200, hoveredBackgroundColor: [60, 64, 88], hoveredBackgroundAlpha: 230, onClick: true },

    { id: "back", text: "Назад", position: [-0.45, 0.12, -0.01], scale: [0.35, 0.35, 0.35], tolerance: [0.13, 0.045],
      backgroundColor: [60, 60, 70], backgroundAlpha: 200, hoveredBackgroundColor: [90, 90, 110], hoveredBackgroundAlpha: 230,
      onClick: { switchTo: "demo_menu" } },
    { id: "close", text: "Закрыть", position: [0.45, 0.12, -0.01], scale: [0.35, 0.35, 0.35], tolerance: [0.18, 0.045],
      backgroundColor: [90, 30, 30], backgroundAlpha: 180, hoveredBackgroundColor: [150, 50, 50], hoveredBackgroundAlpha: 220,
      onClick: { close: true } },
];
