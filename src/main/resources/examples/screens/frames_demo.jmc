// frames_demo: кадровая анимация текста. Кадры (строки или сегменты) сменяют друг друга каждые
// frameInterval тиков; hoveredFrames - свой набор при наведении (hoveredFrameInterval, по умолчанию тот же).
// Тикается каждый серверный тик независимо от tickRate экрана; экраны без кадров ничего не тикают.
// Открой: /displaylib open frames_demo

String id = "frames_demo";
String screenType = "PRIVATE";
int tickRate = 4;
String script = "frames_demo.jmp";

dyn background = { color: [20, 24, 32], alpha: 210, scale: [12, 6, 1], anchor: "CENTER" };

dyn widgets = [
    // Простая анимация: три точки
    { id: "loading", frames: ["Загрузка", "Загрузка.", "Загрузка..", "Загрузка..."], frameInterval: 6,
      position: [0, 1.0, -0.01], scale: [0.6, 0.6, 0.6], backgroundAlpha: 0, tolerance: [0, 0] },

    // Кадры с форматированием и спрайтами: мигающее сердце
    { id: "pulse", frames: [
        [ { text: "HP ", color: "gray" }, { atlas: "minecraft:gui", sprite: "hud/heart/full" } ],
        [ { text: "HP ", color: "gray" }, { atlas: "minecraft:gui", sprite: "hud/heart/half" } ],
        [ { text: "HP ", color: "gray" }, { atlas: "minecraft:gui", sprite: "hud/heart/container" } ],
        [ { text: "HP ", color: "gray" }, { atlas: "minecraft:gui", sprite: "hud/heart/half" } ],
      ], frameInterval: 4,
      position: [0, 0.5, -0.01], scale: [0.6, 0.6, 0.6], backgroundAlpha: 0, tolerance: [0, 0] },

    // Кнопка: в покое статичный текст, при наведении - бегущая стрелка
    { id: "play", text: "Играть",
      hoveredFrames: ["> Играть  ", " > Играть ", "  > Играть", "   Играть>"], hoveredFrameInterval: 3,
      position: [0, -0.3, -0.01], scale: [0.6, 0.6, 0.6], tolerance: [0.45, 0.2],
      backgroundColor: [20, 90, 40], backgroundAlpha: 200, hoveredBackgroundColor: [40, 140, 70], hoveredBackgroundAlpha: 230,
      onClick: true },

    // Кнопка: анимация и в покое, и при наведении (разные интервалы)
    { id: "shimmer",
      frames: [ [ { text: "Магазин", color: "white" } ], [ { text: "Магазин", color: "yellow" } ], [ { text: "Магазин", color: "gold" } ], [ { text: "Магазин", color: "yellow" } ] ],
      frameInterval: 8,
      hoveredFrames: [ [ { text: "Магазин", color: "aqua" } ], [ { text: "Магазин", color: "white" } ] ], hoveredFrameInterval: 4,
      position: [0, -0.9, -0.01], scale: [0.6, 0.6, 0.6], tolerance: [0.5, 0.2],
      backgroundColor: [30, 30, 40], backgroundAlpha: 200, hoveredBackgroundColor: [60, 60, 80], hoveredBackgroundAlpha: 230,
      onClick: true },

    { id: "close", text: "Закрыть", position: [0, -1.6, -0.01], scale: [0.45, 0.45, 0.45], tolerance: [0.35, 0.15],
      backgroundColor: [90, 30, 30], backgroundAlpha: 180, hoveredBackgroundColor: [150, 50, 50], hoveredBackgroundAlpha: 220, onClick: "close" },
];
