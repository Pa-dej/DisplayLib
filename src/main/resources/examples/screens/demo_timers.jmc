// demo_timers: TimerAPI (after, every, times, cancel, active) + import общего модуля lib/util.jmp.
// Таймеры живут, пока открыт экран: при закрытии все отменяются. Скрипт: scripts/demo_timers.jmp

String id = "demo_timers";
String screenType = "PRIVATE";
int tickRate = 4;
String script = "demo_timers.jmp";
dyn morph = { enabled: true, duration: 6, steps: 3 };

dyn background = { color: [40, 40, 48], alpha: 200, scale: [12, 5, 1] };

dyn widgets = [
    { id: "title", text: [ { text: "Таймеры", color: "#6bb647" } ], position: [0, 1.125, -0.01], scale: [0.5, 0.5, 0.5], tolerance: [0, 0] },

    { id: "clock", text: "0 с", position: [0, 0.9, -0.01], scale: [0.4, 0.4, 0.4], tolerance: [0, 0], backgroundAlpha: 0 },

    { id: "tick", text: "Старт секундомера", position: [-0.35, 0.65, -0.01], scale: [0.4, 0.4, 0.4], tolerance: [0.42, 0.05],
      backgroundColor: [20, 90, 40], backgroundAlpha: 200, hoveredBackgroundColor: [40, 140, 70], hoveredBackgroundAlpha: 230, onClick: true },
    { id: "countdown", text: "Отсчёт 5", position: [0.4, 0.65, -0.01], scale: [0.4, 0.4, 0.4], tolerance: [0.25, 0.05],
      backgroundColor: [30, 32, 44], backgroundAlpha: 200, hoveredBackgroundColor: [60, 64, 88], hoveredBackgroundAlpha: 230, onClick: true },

    { id: "later", text: "Через 2 с", position: [-0.35, 0.42, -0.01], scale: [0.4, 0.4, 0.4], tolerance: [0.27, 0.05],
      backgroundColor: [30, 32, 44], backgroundAlpha: 200, hoveredBackgroundColor: [60, 64, 88], hoveredBackgroundAlpha: 230, onClick: true },
    { id: "status", text: "Активных таймеров: 0", position: [0.4, 0.42, -0.01], scale: [0.3, 0.3, 0.3], tolerance: [0, 0], backgroundAlpha: 0 },

    { id: "back", text: "Назад", position: [-0.45, 0.12, -0.01], scale: [0.35, 0.35, 0.35], tolerance: [0.13, 0.045],
      backgroundColor: [60, 60, 70], backgroundAlpha: 200, hoveredBackgroundColor: [90, 90, 110], hoveredBackgroundAlpha: 230,
      onClick: { switchTo: "demo_menu" } },
    { id: "close", text: "Закрыть", position: [0.45, 0.12, -0.01], scale: [0.35, 0.35, 0.35], tolerance: [0.18, 0.045],
      backgroundColor: [90, 30, 30], backgroundAlpha: 180, hoveredBackgroundColor: [150, 50, 50], hoveredBackgroundAlpha: 220,
      onClick: { close: true } },
];
